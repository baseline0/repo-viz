# Build a versioned graph snapshot from tracked Python files.
[group("rv")]
rv-analyze repo out="graph.json" days="30":
    uv run repo-viz analyze --repo "{{ repo }}" --out "{{ out }}" --days "{{ days }}"

# Serve the authenticated FastAPI service.
[group("rv")]
rv-api host="127.0.0.1" port="8080":
    uv run repo-viz api --host "{{ host }}" --port "{{ port }}"

# Validate indicator config and resolve every compute target.
[group("rv")]
rv-check-indicators config="config/indicators.toml":
    uv run repo-viz check-indicators --config "{{ config }}"

# Collect a snapshot, producer values and indicator results for an agent.
[group("rv")]
rv-collect repo out_dir="data" trigger="render" days="30":
    uv run repo-viz collect --repo "{{ repo }}" --out-dir "{{ out_dir }}" --trigger "{{ trigger }}" --days "{{ days }}"

# Run configured indicator evaluators over a snapshot.
[group("rv")]
rv-evaluate-indicators snapshot_path config="config/indicators.toml" out="indicators.json" trigger="render" changed="":
    uv run repo-viz evaluate-indicators --snapshot "{{ snapshot_path }}" --config "{{ config }}" --out "{{ out }}" --trigger "{{ trigger }}" --changed "{{ changed }}"

# Serve the built viewer, graph snapshot and indicator configuration.
[group("rv")]
rv-serve graph host="127.0.0.1" port="8080" config="config/indicators.toml":
    uv run repo-viz serve --graph "{{ graph }}" --host "{{ host }}" --port "{{ port }}" --config "{{ config }}"

# Print node/edge/port counts from a snapshot.
[group("rv")]
rv-summary snapshot_path:
    uv run repo-viz summary --snapshot "{{ snapshot_path }}"
