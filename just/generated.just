# Emit canonical review digests for structural artifacts without writing files.
[group("rv")]
rv-review-digests snapshot results audit="" config="" trigger="":
    uv run repo-viz review-digests --snapshot "{{ snapshot }}" --results "{{ results }}" --audit "{{ audit }}" --config "{{ config }}" --trigger "{{ trigger }}"

# Serve the built viewer, graph snapshot and indicator configuration.
[group("rv")]
rv-serve graph host="127.0.0.1" port="8080" config="config/indicators.toml":
