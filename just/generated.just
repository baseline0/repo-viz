# Build a versioned graph snapshot from tracked Python files.
[group("rv")]
rv-analyze repo out="graph.json" days="30":
    uv run repo-viz analyze --repo "{{ repo }}" --out "{{ out }}" --days "{{ days }}"

# Serve the authenticated FastAPI service.
[group("rv")]
rv-api host="127.0.0.1" port="8080":
    uv run repo-viz api --host "{{ host }}" --port "{{ port }}"

# Assess a repository, computing Lift, Squeeze, and ROI-ranked refactoring candidates.
[group("rv")]
rv-assess repo out="" days="30" config="":
    uv run repo-viz assess --repo "{{ repo }}" --out "{{ out }}" --days "{{ days }}" --config "{{ config }}"

# Walk all fleet and tool repositories, compiling a unified antipattern and refactoring ledger.
[group("rv")]
rv-assess-fleet root patterns="fleet-*,tool-*" out="" csv="" days="30" config="":
    uv run repo-viz assess-fleet --root "{{ root }}" --patterns "{{ patterns }}" --out "{{ out }}" --csv "{{ csv }}" --days "{{ days }}" --config "{{ config }}"

# Audit one component from existing artifacts.
[group("rv")]
rv-audit node snapshot="" results="" out="":
